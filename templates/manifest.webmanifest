{% load static %}
{
  "name": "{{ store.store_name }}",
  "short_name": "DESI VIBES",
  "description": "{{ store.tagline }} — premium Indian ethnic wear for men.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F7F1E8",
  "theme_color": "{{ store.theme_color|default:'#801C2A' }}",
  "lang": "en-IN",
  "categories": ["shopping", "lifestyle"],
  "icons": [
    {
      "src": "{% static 'brand/logo.webp' %}",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "{% static 'brand/logo.webp' %}",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any"
    }
  ]
}
