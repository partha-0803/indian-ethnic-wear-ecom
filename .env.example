DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Neon / Postgres connection string (required for production)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Vercel Blob — required for admin image uploads on Vercel (read-only FS).
# Create a Blob store in the Vercel dashboard and link it to this project;
# Vercel injects BLOB_READ_WRITE_TOKEN automatically on deploy.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
